{
  "name": "azucar-rush",
  "version": "1.0.0",
  "description": "Azúcar Rush - 3D Bakery Game",
  "author": "AzucarRush",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:icon": "node scripts/generate-icon.js",
    "electron:dev": "electron .",
    "electron:build": "next build && node scripts/generate-icon.js && electron-builder --win portable"
  },
  "build": {
    "appId": "com.azucarrush.game",
    "productName": "Azúcar Rush",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "artifactName": "AzucarRush-portable.exe",
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "AzucarRush-portable.exe"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@next/swc-win32-x64-msvc": "^14.2.15",
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.155.0",
    "autoprefixer": "^10.4.18",
    "babel-loader": "^10.1.1",
    "canvas-confetti": "^1.9.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.344.0",
    "next": "14.2.15",
    "postcss": "^8.4.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.1",
    "three": "^0.160.0",
    "typescript": "^5.4.0"
  }
}
